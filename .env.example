# ==============================================================================
# Rat Racer BDQ — Vadodara IT Fresher Job Finder Configuration
# Copy this file to .env for local runs, or add these as GitHub Repo Secrets.
# ==============================================================================

# --- 1. Gmail Email Alerts (Required for email notifications) ---
# Your Gmail address (used to send alerts)
GMAIL_USER=yourname@gmail.com

# 16-character Google App Password (NOT your regular Gmail password)
# Create one at: https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Recipient email address (defaults to GMAIL_USER if omitted)
ALERT_EMAIL_TO=yourname@gmail.com

# URL of your hosted GitHub Pages dashboard (included in email footer)
DASHBOARD_URL=https://YOUR_GITHUB_USERNAME.github.io/RAT-RACER-BDQ/

# --- 2. Optional Free Job API Keys (Boosts coverage across Naukri/Indeed/Foundit/Google Jobs) ---
# LinkedIn Public & Internshala work out of the box with NO API keys.
# Adding any of the free keys below pulls even more Vadodara fresher listings!

# Adzuna India API (Free tier: 250 calls/day) -> https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (Free tier: aggregates Google Jobs = Naukri, Indeed, LinkedIn, Foundit)
# -> https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Jooble API (Free API key) -> https://jooble.org/api/about
JOOBLE_API_KEY=

# --- 3. Optional Runtime Tuning ---
# Max days to keep old jobs on the dashboard before auto-pruning (default: 30)
MAX_JOB_AGE_DAYS=30

# Set to "false" to restrict strictly to Vadodara only (default "true" fetches Vadodara + Remote India/Worldwide)
INCLUDE_REMOTE_INDIA=true

# Only show remote companies verified on Glassdoor (blocks fake/spam remote companies; default: true)
REQUIRE_GLASSDOOR_FOR_REMOTE=true

# Dynamic live auto-fetch interval in seconds when running `npm run serve` (default: 60 = every 1 minute, 0 to disable)
AUTO_FETCH_INTERVAL_SECONDS=60
